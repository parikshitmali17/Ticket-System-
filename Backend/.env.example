PORT=5000

# Replace with your real PostgreSQL credentials (do not leave username:password).
# Example local:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/support_ticket_db
# Example remote PC:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@192.168.1.50:5432/support_ticket_db
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/support_ticket_db

GEMINI_API_KEY=your_gemini_api_key